# Public by design: protected by Row Level Security in supabase/migrations/0001_init.sql
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Never add the service-role key here for client use. If admin tooling needs it, keep it server-only.

# Server-only (no NEXT_PUBLIC_ prefix): enables the real Build Assistant at /api/assistant.
# Without it the assistant runs in demo mode with sample answers. Add it in Vercel → Settings → Environment Variables.
ANTHROPIC_API_KEY=

# Alternative to ANTHROPIC_API_KEY: route the assistant through OpenRouter (takes priority when set). Server-only.
OPENROUTER_API_KEY=
# Optional: model ids from https://openrouter.ai/models, comma-separated: the first is the primary, the rest are
# tried in order when it is unavailable. Unset = the cheapest models in OpenRouter's live catalogue, free ones first.
OPENROUTER_MODEL=
# Optional: assistant questions per user per UTC day (default 50, max 1000). Counted in Supabase (migration 0002).
ASSISTANT_DAILY_LIMIT=
